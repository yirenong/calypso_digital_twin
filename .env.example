# Server-only pooled Neon connection; add this to Vercel Environment Variables.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Optional direct connection for backend:setup migrations.
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@HOST.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# For npm run dev:backend only. Production builds always use server sign-in.
VITE_ACCOUNT_BACKEND=true
# Server-only ST Synthesis credentials, also required in production hosting.
ST_SYNTHESIS_EMAIL=
ST_SYNTHESIS_PASSWORD=
