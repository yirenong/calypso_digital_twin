{
  "name": "calypso-digital-twin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5175",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4175",
    "test": "node --test tests/*.test.js",
    "test:ui": "playwright test",
    "dev:backend": "vite --mode backend --host 127.0.0.1 --port 5176",
    "backend:setup": "node --env-file=.env.backend.local scripts/setup-backend.mjs",
    "test:backend": "node --env-file=.env.backend-test.local --test tests/backend.integration.js",
    "test:backend:ui": "node --env-file=.env.backend-test.local node_modules/@playwright/test/cli.js test --config playwright.backend.config.js",
    "backend:seed-demo": "node --env-file=.env.backend.local scripts/seed-powerplus-demo.mjs"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "6.7.2",
    "@vercel/functions": "^3.10.2",
    "chart.js": "4.5.1",
    "exceljs": "^4.4.0",
    "gridstack": "^14.0.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "pg": "^8.23.1",
    "vue": "^3.5.43",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@vitejs/plugin-vue": "5.2.3",
    "pdfjs-dist": "^6.4.299",
    "vite": "^6.4.4"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
